# ---- Supabase (required) ----
# Project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Use the SERVICE ROLE key (server-side only). Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Samsara (required for truck# tracking) ----
# Dashboard: Settings -> API Tokens. Needs read access to Vehicle Statistics.
SAMSARA_API_TOKEN=samsara_api_xxxxxxxx
# Have a second Samsara account? Add its token(s) here, comma-separated.
# Both SAMSARA_API_TOKEN and these are queried and merged.
SAMSARA_API_TOKENS=
# Only change if your org is on the EU tier: https://api.eu.samsara.com
SAMSARA_BASE_URL=https://api.samsara.com

# ---- Live Share scraping (for trucks with no API token) ----
# How many pasted-link loads to refresh per check (keep low on Vercel Hobby's 10s limit).
CHECK_BATCH_LINKS=2
# Optional external headless browser (e.g. Browserless) instead of bundled Chromium.
BROWSER_WS_ENDPOINT=
# Local dev only: path to a Chrome/Chromium binary.
LOCAL_CHROME_PATH=

# ---- Maps / ETA (required) ----
# "mapbox" (default, generous free tier) or "google"
MAPS_PROVIDER=mapbox
# From https://account.mapbox.com (free). Only needed if MAPS_PROVIDER=mapbox.
MAPBOX_TOKEN=pk.xxxxxxxx
# Optional: a more forgiving geocoder for messy pasted addresses. Geocoding runs
# once per load (then cached), so Google here costs almost nothing.
# Leave blank to use MAPS_PROVIDER. Set to "google" and add GOOGLE_MAPS_KEY to use
# Google just for address lookups while keeping Mapbox for ETAs.
GEOCODE_PROVIDER=
# Needed if MAPS_PROVIDER=google or GEOCODE_PROVIDER=google. Also acts as an
# automatic fallback geocoder if Mapbox can't find an address.
GOOGLE_MAPS_KEY=

# ---- Resend email (required for alerts) ----
RESEND_API_KEY=re_xxxxxxxxxxxx
# The shared sender works with NO domain verification, but Resend will then only
# deliver to the email you signed up to Resend with. Keep as-is.
RESEND_FROM=STL Truckers Load Tracker <onboarding@resend.dev>
# Where alerts are sent. Use the same address you registered with Resend.
NOTIFY_EMAIL=dispatch@stltruckers.com

# ---- Check endpoint protection ----
# Any random string. UptimeRobot must call /api/check?key=THIS_VALUE
CHECK_SECRET=change-me-to-a-long-random-string

# ---- Tuning (optional) ----
# Minutes past the deadline before a load is flagged Late (0 = strict).
LATE_GRACE_MIN=0
# Deadlines are read in each destination's LOCAL time, detected automatically
# from the address. This is only a fallback if a location can't be resolved.
DEFAULT_TIMEZONE=America/Chicago
