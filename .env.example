# ============================================================
# TruckOn.site
# ============================================================

# ---- Supabase (required) ----
# Project: load-tracker-v2 (us-east-1)
NEXT_PUBLIC_SUPABASE_URL=https://fwlwydgnxiscwrogrqgm.supabase.co
# Publishable / anon key — safe in the browser, governed by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server only, bypasses RLS. Used ONLY by the cron worker
# and the admin panel. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- App ----
# Used to build the deep links in alert emails.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ---- Routing / ETA ----
# Distance comes from a truck-legal router, speed from a traffic-aware one.
#
# OpenRouteService supplies the PATH: driving-hgv with the vehicle restrictions
# below, so a 13'6" trailer is never routed under a low bridge. Free, no card on
# file, 2,000 directions/day. https://openrouteservice.org/dev/#/signup
ORS_API_KEY=
# Mapbox supplies the SPEED along that path: driving-traffic inside
# CLOSE_IN_MILES, free-flow driving beyond it. Free below 100,000 requests per
# month; this fleet runs ~8,200/month.
MAPBOX_TOKEN=
# Optional last-resort geocoder for messy addresses. Cached per load, so cheap.
# Free below 10,000 geocodes/month; realistic usage here is a few dozen.
GOOGLE_MAPS_KEY=

# Accuracy policy: inside this distance we ask for live traffic data.
CLOSE_IN_MILES=100
# Straight-line distance under which a stop is marked Arrived outright.
# 0.1 mi = 528 ft, so "arrived" means at the facility, not near it.
ARRIVAL_MILES=0.1
# Second arrival rule, for big yards: within this distance AND stationary for
# ARRIVAL_DWELL_MIN also counts as arrived. The dwell is what makes the wider
# radius safe — a truck driving past never qualifies. Needs Samsara API (truck#)
# rows; Live Share rows have no speed and use ARRIVAL_MILES alone.
ARRIVAL_NEAR_MILES=0.5
ARRIVAL_DWELL_MIN=15
# GPS jitter keeps a parked truck reading slightly above zero.
STOPPED_MPH=2

# Give up on a load this many hours past its alert time with no arrival. Without
# this a late row sits in the 5-minute tier forever — 288 checks/day for one row
# nobody will close, which is how a handful of abandoned loads would exhaust the
# ORS free quota. The row stays visible and says why it stopped.
TRACK_MAX_HOURS_PAST_DEADLINE=48

# Vehicle restrictions, in METRES and TONNES — ORS needs these to route around
# low bridges and weight limits. Defaults are a standard 53' dry van at legal
# max gross: 13'6" high, 102" wide, ~73' long, 80,000 lb, 20,000 lb per axle.
# Raise VEHICLE_HEIGHT_M at your peril; it is the one bridges care about.
VEHICLE_HEIGHT_M=4.11
VEHICLE_WIDTH_M=2.6
VEHICLE_LENGTH_M=22.25
VEHICLE_WEIGHT_T=36.29
VEHICLE_AXLELOAD_T=9.07

# ORS timing calibration, used when Mapbox is down and ORS has to supply the
# speed as well as the path. ORS driving-hgv reports ~41 mph on US interstates
# against a real ~65; ORS_CALIBRATION divides its duration, and ORS_MAX_AVG_MPH
# caps the implied average speed. The slower of the two wins, so a bad constant
# here can only ever make ETAs more conservative. ORS_MAX_AVG_MPH also caps the
# speed borrowed from Mapbox, since a car's pace is not a loaded truck's.
ORS_CALIBRATION=1.55
ORS_MAX_AVG_MPH=65

# ---- Hard spend caps (per day) ----
# The real protection against a runaway loop. Mapbox and Google are the ones
# that can bill; the others exist to stay clear of the providers' rate limiters.
# 3,000/day = 93,000/month, so this cap binds before Mapbox's 100k free tier is
# exhausted — staying under it is the same thing as staying at $0.
MAPBOX_DAILY_CAP=3000
ORS_DAILY_CAP=1800
NOMINATIM_DAILY_CAP=1000
GOOGLE_DAILY_CAP=200
# Nominatim's policy REQUIRES an identifying User-Agent with real contact info.
NOMINATIM_UA=BakhtiyorRustamov (bakhtiyor1chi@gmail.com)

# ---- Samsara (optional, for truck# mode) ----
# Instance-owner fallback. Individual users add their own token in the admin
# panel, which is encrypted at rest with ENCRYPTION_KEY.
SAMSARA_API_TOKEN=
SAMSARA_API_TOKENS=
SAMSARA_BASE_URL=https://api.samsara.com

# ---- Email (Resend) ----
RESEND_API_KEY=
# IMPORTANT: onboarding@resend.dev only delivers to the address the Resend
# account was registered with. With multiple users, everyone else silently gets
# nothing — so verify a domain before inviting anyone.
RESEND_FROM=TruckOn <alerts@truckon.site>

# ---- Secrets ----
# Encrypts per-user Samsara tokens. 64 hex chars.
ENCRYPTION_KEY=
# Guards /api/check. The pg_cron job must send ?key=THIS_VALUE
CHECK_SECRET=
# Admin panel at /admin (no nav link anywhere).
ADMIN_PASSWORD=
ADMIN_SECRET=

# ---- Limits ----
MAX_USERS=3
SIGNUP_BONUS_CENTS=5000
# Rows swept per cron tick.
CHECK_BATCH=40

# ---- Tuning ----
# Minutes past the alert time before a load is flagged Late (0 = strict).
LATE_GRACE_MIN=0
# Fallback only; deadlines are read in the destination's local time.
DEFAULT_TIMEZONE=America/Chicago

# ---- Samsara history backfill ----
# Live checks are samples, so a short stop can fall between two of them. When a
# row is past its appointment and still open, the truck's breadcrumbs are
# replayed once to ask "was it ever parked there?". This is ONE CALL PER
# VEHICLE (unlike the shared GPS snapshot), so it is gated hard: truck# rows
# only, only after the appointment, at most once an hour per row.
HISTORY_MIN_GAP_MIN=60
HISTORY_LOOKBACK_HOURS=12
